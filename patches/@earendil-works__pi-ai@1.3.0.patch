diff --git a/dist/api/antigravity-acp.js b/dist/api/antigravity-acp.js
new file mode 100644
index 0000000..7af1f5a
--- /dev/null
+++ b/dist/api/antigravity-acp.js
@@ -0,0 +1,416 @@
+/**
+ * Google Antigravity bridge (AI Pro subscription) over the Agent Client
+ * Protocol. Mirroring the OpenBot ACP integration:
+ * - Persistent ACP daemon connection (no spawn/kill per turn).
+ * - Automatic tool permission approval (allow_always / allow_once).
+ * - Real multi-turn session persistence across conversation turns.
+ * - Robust message content extraction (supporting string and block arrays).
+ * - Real-time streaming of thinking and tool execution status.
+ */
+import { spawn } from "node:child_process";
+import { calculateCost } from "../models.js";
+import { formatProviderError, normalizeProviderError } from "../utils/error-body.js";
+import { AssistantMessageEventStream } from "../utils/event-stream.js";
+import { collapseSystemMessages, getInitialSystemMessage } from "../utils/transcript.js";
+
+/** Resolve the ACP server binary; the bundled install lives under ~/opt. */
+function acpServerPath() {
+    return process.env.AGY_ACP_SERVER_PATH || `${process.env.HOME}/opt/antigravity/bin/agy_acp_server.par`;
+}
+function acpHarnessPath() {
+    return process.env.ANTIGRAVITY_HARNESS_PATH || `${process.env.HOME}/opt/antigravity/bin/localharness_external`;
+}
+
+/** Flatten one message's content into text the ACP transcript can carry. */
+function messageText(message) {
+    if (!message) return "";
+    if (typeof message === "string") return message;
+    if (typeof message.content === "string") return message.content;
+    const parts = [];
+    if (Array.isArray(message.content)) {
+        for (const block of message.content) {
+            if (!block) continue;
+            if (typeof block === "string") parts.push(block);
+            else if (block.type === "text" && typeof block.text === "string") parts.push(block.text);
+            else if (block.type === "thinking" && typeof block.thinking === "string") parts.push(`[thinking] ${block.thinking}`);
+            else if (block.type === "toolCall") parts.push(`[tool call ${block.name || "tool"}] ${JSON.stringify(block.arguments || {})}`);
+            else if (block.type === "image") parts.push("[image attachment]");
+        }
+    }
+    return parts.join("\n");
+}
+
+/** Replay the transcript as one labelled prompt for initial turns. */
+function buildPrompt(messages) {
+    const lines = [];
+    for (const message of messages) {
+        if (message.role === "system") continue;
+        const text = messageText(message).trim();
+        if (!text) continue;
+        lines.push(message.role === "assistant" ? `Assistente: ${text}` : `Usuário: ${text}`);
+    }
+    const fullText = lines.join("\n\n").trim();
+    return [{ type: "text", text: fullText || "Olá" }];
+}
+
+/** For continued multi-turn sessions, send only the latest user message. */
+function lastUserPrompt(messages) {
+    for (let i = messages.length - 1; i >= 0; i--) {
+        if (messages[i].role === "user") {
+            const text = messageText(messages[i]).trim();
+            if (text) return [{ type: "text", text }];
+        }
+    }
+    return buildPrompt(messages);
+}
+
+function ensureNonEmptyPrompt(promptList, fallback = "Olá") {
+    if (!Array.isArray(promptList) || promptList.length === 0) {
+        return [{ type: "text", text: fallback }];
+    }
+    const valid = promptList.filter((p) => p && p.type === "text" && p.text && p.text.trim().length > 0);
+    return valid.length > 0 ? valid : [{ type: "text", text: fallback }];
+}
+
+function resolveWorkspaceCwd(systemPrompt) {
+    if (systemPrompt) {
+        const match = /(?:Working directory|Current directory|workspace):\s*([^\n\r]+)/i.exec(systemPrompt);
+        if (match && match[1]) {
+            const candidate = match[1].trim().replace(/^["']|["']$/g, "");
+            if (candidate.startsWith("/")) return candidate;
+        }
+    }
+    return process.env.PWD || process.cwd();
+}
+
+/**
+ * Singleton ACP Daemon manager keeping agy_acp_server.par alive.
+ */
+class AcpDaemon {
+    constructor() {
+        this.child = null;
+        this.pending = new Map();
+        this.nextId = 0;
+        this.sessionListeners = new Map();
+        this.initPromise = null;
+        this.isDead = false;
+        this.acpSessionMap = new Map(); // dshSessionId -> acpSessionId
+    }
+
+    start() {
+        if (this.child && !this.isDead) return;
+        this.isDead = false;
+        this.child = spawn(acpServerPath(), ["--uid="], {
+            stdio: ["pipe", "pipe", "pipe"],
+            env: {
+                ...process.env,
+                AGY_ACP_FORCE_FILE_STORAGE: "1",
+                ANTIGRAVITY_HARNESS_PATH: acpHarnessPath(),
+            },
+        });
+
+        let buffer = "";
+        this.child.stdout.on("data", (chunk) => {
+            buffer += chunk.toString();
+            let newlineIndex;
+            while ((newlineIndex = buffer.indexOf("\n")) !== -1) {
+                const line = buffer.slice(0, newlineIndex).trim();
+                buffer = buffer.slice(newlineIndex + 1);
+                if (!line) continue;
+                let message;
+                try { message = JSON.parse(line); } catch { continue; }
+
+                if (message.id !== undefined && this.pending.has(message.id)) {
+                    const { resolve, reject } = this.pending.get(message.id);
+                    this.pending.delete(message.id);
+                    if (message.error) reject(new Error(`${message.error.message} (code ${message.error.code})`));
+                    else resolve(message.result);
+                } else if (message.method === "session/request_permission") {
+                    // OpenBot strategy: automatically approve tools with allow_always or allow_once
+                    const options = message.params?.options ?? [];
+                    const allow = options.find((opt) =>
+                        opt.kind === "allow_always" ||
+                        opt.kind === "allow_once" ||
+                        /allow|approve|always|once|yes/i.test(opt.kind ?? opt.id ?? opt.name ?? "")
+                    );
+                    const result = allow
+                        ? { outcome: { outcome: "selected", optionId: allow.id ?? allow.optionId } }
+                        : options[0]
+                            ? { outcome: { outcome: "selected", optionId: options[0].id ?? options[0].optionId } }
+                            : { outcome: { outcome: "cancelled" } };
+                    this.child.stdin.write(JSON.stringify({ jsonrpc: "2.0", id: message.id, result }) + "\n");
+                } else if (message.method === "session/update") {
+                    const update = message.params?.update ?? {};
+                    const sessionId = message.params?.sessionId || update?.sessionId;
+                    if (sessionId && this.sessionListeners.has(sessionId)) {
+                        this.sessionListeners.get(sessionId)(update);
+                    } else {
+                        for (const listener of this.sessionListeners.values()) {
+                            listener(update);
+                        }
+                    }
+                }
+            }
+        });
+
+        this.child.on("exit", () => {
+            this.isDead = true;
+            this.acpSessionMap.clear();
+            for (const { reject } of this.pending.values()) {
+                reject(new Error("Antigravity ACP server exited unexpectedly"));
+            }
+            this.pending.clear();
+        });
+
+        this.child.on("error", (err) => {
+            this.isDead = true;
+            this.acpSessionMap.clear();
+            for (const { reject } of this.pending.values()) {
+                reject(err);
+            }
+            this.pending.clear();
+        });
+    }
+
+    request(method, params) {
+        return new Promise((resolve, reject) => {
+            if (this.isDead || !this.child) {
+                return reject(new Error("Antigravity ACP server is not running"));
+            }
+            const id = ++this.nextId;
+            this.pending.set(id, { resolve, reject });
+            this.child.stdin.write(JSON.stringify({ jsonrpc: "2.0", id, method, params }) + "\n");
+        });
+    }
+
+    async ensureInitialized() {
+        if (this.child && !this.isDead && !this.initPromise) return;
+        if (this.initPromise) return await this.initPromise;
+        this.initPromise = (async () => {
+            this.start();
+            await this.request("initialize", {
+                protocolVersion: 1,
+                clientCapabilities: { fs: { read: true, write: true }, terminal: { run: true } },
+            });
+            await this.request("authenticate", { methodId: "oauth-personal" });
+            this.initPromise = null;
+        })().catch((err) => {
+            this.initPromise = null;
+            this.isDead = true;
+            throw err;
+        });
+        return await this.initPromise;
+    }
+}
+
+const globalDaemon = new AcpDaemon();
+
+process.on("exit", () => {
+    if (globalDaemon.child && !globalDaemon.isDead) {
+        try { globalDaemon.child.kill("SIGTERM"); } catch { /* ignore */ }
+    }
+});
+
+const ACP_STOP_REASONS = {
+    end_turn: "stop",
+    max_tokens: "length",
+    refusal: "error",
+    cancelled: "aborted",
+};
+
+export const stream = (model, context, options) => {
+    const stream = new AssistantMessageEventStream();
+    const normalizedContext = collapseSystemMessages(context);
+    (async () => {
+        const output = {
+            role: "assistant",
+            content: [],
+            api: "antigravity-acp",
+            provider: model.provider,
+            model: model.id,
+            usage: {
+                input: 0, output: 0, cacheRead: 0, cacheWrite: 0,
+                totalTokens: 0, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+            },
+            stopReason: "pending",
+            timestamp: Date.now(),
+        };
+        try {
+            await globalDaemon.ensureInitialized();
+            stream.push({ type: "start", partial: output });
+
+            const systemMessage = getInitialSystemMessage(normalizedContext.messages);
+            const systemPrompt = systemMessage ? messageText(systemMessage) : undefined;
+            const ptDirective = "Você é o assistente de IA do DeepSeek Harness no Linux. IMPORTANTE: Fale e responda SEMPRE em Português do Brasil (pt-BR) de forma prestativa, direta e atenciosa a todas as perguntas. Nunca responda em inglês.";
+            const fullSystemPrompt = systemPrompt ? `${systemPrompt}\n\n${ptDirective}` : ptDirective;
+            const cwd = resolveWorkspaceCwd(fullSystemPrompt);
+
+            // Separate title generation or ephemeral requests from persistent chat sessions
+            const isTitleRequest = Boolean(fullSystemPrompt && /title|concise title/i.test(fullSystemPrompt));
+            const dshSessionKey = (options?.sessionId && !isTitleRequest) ? String(options.sessionId) : null;
+            let acpSessionId = dshSessionKey ? globalDaemon.acpSessionMap.get(dshSessionKey) : null;
+            let isNewSession = false;
+
+            if (!acpSessionId) {
+                isNewSession = true;
+                const session = await globalDaemon.request("session/new", {
+                    cwd,
+                    mcpServers: [],
+                    _meta: { antigravity: { systemPrompt: { append: fullSystemPrompt } } },
+                });
+                acpSessionId = session.sessionId;
+                if (dshSessionKey) {
+                    globalDaemon.acpSessionMap.set(dshSessionKey, acpSessionId);
+                }
+            }
+
+            await globalDaemon.request("session/set_model", { sessionId: acpSessionId, modelId: model.id });
+
+            let rawPrompt = isNewSession
+                ? buildPrompt(normalizedContext.messages)
+                : lastUserPrompt(normalizedContext.messages);
+            let prompt = ensureNonEmptyPrompt(rawPrompt);
+
+            let currentBlock = null;
+            const blocks = output.content;
+
+            const onUpdate = (update) => {
+                const kind = update.sessionUpdate;
+                let text = "";
+                let wantType = "text";
+
+                if (kind === "agent_message_chunk") {
+                    text = update.content?.text ?? "";
+                    wantType = "text";
+                } else if (kind === "agent_thought_chunk") {
+                    text = update.content?.text ?? "";
+                    wantType = "thinking";
+                } else if (kind === "tool_call") {
+                    const title = update.title || update.name || update.kind || "ferramenta";
+                    text = `\n[Executando: ${title}]\n`;
+                    wantType = "thinking";
+                } else if (kind === "tool_call_update") {
+                    if (update.status === "completed") {
+                        text = `[Concluído]\n`;
+                        wantType = "thinking";
+                    } else if (update.status === "failed") {
+                        text = `[Falhou]\n`;
+                        wantType = "thinking";
+                    }
+                }
+
+                if (!text) return;
+
+                if (!currentBlock || currentBlock.type !== wantType) {
+                    if (currentBlock) {
+                        stream.push({
+                            type: currentBlock.type === "text" ? "text_end" : "thinking_end",
+                            contentIndex: blocks.length - 1,
+                            content: currentBlock.type === "text" ? currentBlock.text : currentBlock.thinking,
+                            partial: output,
+                        });
+                    }
+                    currentBlock = wantType === "text" ? { type: "text", text: "" } : { type: "thinking", thinking: "" };
+                    blocks.push(currentBlock);
+                    stream.push({
+                        type: wantType === "text" ? "text_start" : "thinking_start",
+                        contentIndex: blocks.length - 1,
+                        partial: output,
+                    });
+                }
+
+                if (wantType === "text") currentBlock.text += text;
+                else currentBlock.thinking += text;
+
+                stream.push({
+                    type: wantType === "text" ? "text_delta" : "thinking_delta",
+                    contentIndex: blocks.length - 1,
+                    delta: text,
+                    partial: output,
+                });
+            };
+
+            globalDaemon.sessionListeners.set(acpSessionId, onUpdate);
+
+            let response;
+            try {
+                response = await globalDaemon.request("session/prompt", { sessionId: acpSessionId, prompt });
+            } catch (err) {
+                if (dshSessionKey && !isNewSession && /session|non-empty/i.test(err.message)) {
+                    // Session was lost or invalid; recreate and replay with full prompt
+                    globalDaemon.acpSessionMap.delete(dshSessionKey);
+                    const session = await globalDaemon.request("session/new", {
+                        cwd,
+                        mcpServers: [],
+                        _meta: { antigravity: { systemPrompt: { append: fullSystemPrompt } } },
+                    });
+                    acpSessionId = session.sessionId;
+                    globalDaemon.acpSessionMap.set(dshSessionKey, acpSessionId);
+                    globalDaemon.sessionListeners.set(acpSessionId, onUpdate);
+                    await globalDaemon.request("session/set_model", { sessionId: acpSessionId, modelId: model.id });
+                    prompt = ensureNonEmptyPrompt(buildPrompt(normalizedContext.messages));
+                    response = await globalDaemon.request("session/prompt", { sessionId: acpSessionId, prompt });
+                } else {
+                    throw err;
+                }
+            } finally {
+                globalDaemon.sessionListeners.delete(acpSessionId);
+            }
+
+            if (response?.stopReason) {
+                output.stopReason = ACP_STOP_REASONS[response.stopReason] ?? "stop";
+                if (output.content.some((b) => b.type === "toolCall") && output.stopReason === "stop") {
+                    output.stopReason = "toolUse";
+                }
+            } else {
+                output.stopReason = "stop";
+            }
+
+            const usage = response?.usage;
+            if (usage) {
+                output.usage = {
+                    input: usage.inputTokens ?? 0,
+                    output: usage.outputTokens ?? 0,
+                    cacheRead: usage.cachedReadTokens ?? 0,
+                    cacheWrite: usage.cachedWriteTokens ?? 0,
+                    reasoning: usage.thoughtTokens ?? 0,
+                    totalTokens: usage.totalTokens ?? 0,
+                    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+                };
+                calculateCost(model, output.usage);
+            }
+
+            if (currentBlock) {
+                stream.push({
+                    type: currentBlock.type === "text" ? "text_end" : "thinking_end",
+                    contentIndex: blocks.length - 1,
+                    content: currentBlock.type === "text" ? currentBlock.text : currentBlock.thinking,
+                    partial: output,
+                });
+            }
+
+            if (options?.signal?.aborted) {
+                try { await globalDaemon.request("session/cancel", { sessionId: acpSessionId }); } catch { /* ignore */ }
+                output.stopReason = "aborted";
+                output.errorMessage = "Request was aborted";
+            }
+
+            if (output.stopReason === "aborted" || output.stopReason === "error") {
+                stream.push({ type: "error", reason: output.stopReason, error: output });
+                stream.end();
+                return;
+            }
+
+            stream.push({ type: "done", reason: output.stopReason, message: output });
+            stream.end();
+        } catch (error) {
+            output.stopReason = options?.signal?.aborted ? "aborted" : "error";
+            output.errorMessage = formatProviderError(normalizeProviderError(error));
+            stream.push({ type: "error", reason: output.stopReason, error: output });
+            stream.end();
+        }
+    })();
+    return stream;
+};
+
+export const streamSimple = (model, context, options) => stream(model, context, options);
