+/**
+ * Antigravity provider: Google AI Pro subscription models served through the
+ * local ACP runtime. Authentication is ambient — the runtime reads the token
+ * file the IDE/CLI login writes, so a stored credential is never required.
+ */
+import { existsSync, readFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import * as antigravityAcpApi from "../api/antigravity-acp.js";
+import { createProvider } from "../models.js";
+import { ANTIGRAVITY_MODELS } from "./antigravity.models.js";
+const TOKEN_FILENAME = "acp_token.json";
+function tokenPath() {
+    return join(process.env.GEMINI_HOME || join(homedir(), ".gemini"), "antigravity-acp", TOKEN_FILENAME);
+}
+function antigravityAuth() {
+    return {
+        name: "Antigravity (Google AI Pro)",
+        async resolve() {
+            const path = tokenPath();
+            if (!existsSync(path)) return undefined;
+            try {
+                const parsed = JSON.parse(readFileSync(path, "utf8"));
+                if (!parsed?.refresh_token) return undefined;
+                return { auth: { apiKey: "acp-managed" }, source: path };
+            } catch {
+                return undefined;
+            }
+        },
+    };
+}
+export function antigravityProvider() {
+    return createProvider({
+        id: "antigravity",
+        name: "Antigravity (Google AI Pro)",
+        baseUrl: "acp://local",
+        auth: { apiKey: antigravityAuth() },
+        models: Object.values(ANTIGRAVITY_MODELS),
+        api: antigravityAcpApi,
+    });
+}
